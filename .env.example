DATABASE_URL=postgres://tackt:tackt@127.0.0.1:5432/indexer
# Optional only for core-api, which warns and skips user lifecycle events
# without it. Required by Indexer, Ledger and risk-engine.
NATS_URL=nats://127.0.0.1:4222
CORE_API_LISTEN_ADDR=127.0.0.1:8080
# Internal/operator-only bearer secret. Use at least 24 random characters outside local development.
CORE_API_OPERATOR_TOKEN=local-development-operator-token
CORE_API_DATABASE_CONNECTIONS=10
# Required Core auth settings. Solana and EVM login are always available.
CORE_API_AUTH_ISSUER=https://api.example.com
# Trusted frontend URI used by both wallet signing methods and their CORS origin.
CORE_API_AUTH_FRONTEND_URI=https://app.example.com
# Generate at least 32 random bytes with `openssl rand -hex 32`; inject as a secret.
# CORE_API_AUTH_JWT_SECRET=<hex-encoded-random-secret>
# OIDC providers require their deployment-specific credentials; omit or use [] when none are configured.
# CORE_API_AUTH_PROVIDERS='[{"name":"google","issuer":"https://accounts.google.com","client_id":"<client-id>","client_secret":"<client-secret>","redirect_url":"https://app.example.com/auth/callback"}]'
# First-login provisioning is disabled unless explicitly enabled.
CORE_API_USER_SIGNUP_ENABLED=false
INDEXER_LISTEN_ADDR=127.0.0.1:8081
LEDGER_LISTEN_ADDR=127.0.0.1:8082
LEDGER_DATABASE_CONNECTIONS=20
# Core-to-Ledger bearer secret. Use at least 32 random printable ASCII characters.
LEDGER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
LEDGER_ALLOW_CLEARTEXT=false
LEDGER_HTTP_MAX_BODY_BYTES=16384
LEDGER_HTTP_MAX_IN_FLIGHT=64
# Optional privileged migrator connection when DATABASE_URL uses a least-privilege runtime role.
# LEDGER_MIGRATION_DATABASE_URL=postgres://ledger_migrator:secret@127.0.0.1:5432/indexer
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Required newHeads signal; HTTP remains authoritative for ingestion.
ETHEREUM_WS_URL=wss://ethereum-rpc.publicnode.com
ETHEREUM_CHAIN_ID=1
ETHEREUM_CONFIRMATIONS=12
# Required QuickNode Hyperliquid endpoint and secret. Keep the token out of the URL.
HYPERLIQUID_GRPC_URL=https://your-endpoint.hype-mainnet.quiknode.pro:10000
HYPERLIQUID_GRPC_TOKEN=replace-with-provider-token
# Bootstrap and account-registry overlap (about five minutes at 12 blocks/s); not historical import.
HYPERLIQUID_INITIAL_LOOKBACK_BLOCKS=3600
HYPERLIQUID_RECONCILE_SECONDS=300
# Risk-engine service (all RISK_ENGINE_* variables have development defaults
# except the snapshot directory; see services/risk-engine/README.md).
RISK_ENGINE_LISTEN_ADDR=127.0.0.1:8083
RISK_ENGINE_SNAPSHOT_DIR=./target/risk-snapshots
