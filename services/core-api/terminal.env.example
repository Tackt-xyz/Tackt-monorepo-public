# Core API configuration for the web terminal. Supply real values through your
# deployment's environment/secret manager. Core does not auto-load this file.
# Empty required secrets intentionally prevent startup; never commit filled values.
DATABASE_URL=
CORE_API_OPERATOR_TOKEN=
CORE_API_LISTEN_ADDR=127.0.0.1:8080

# Use your public Core origin and terminal origin. These must share an HTTPS site.
# With a same-origin /api proxy, the issuer can be the public terminal origin.
CORE_API_AUTH_ISSUER=https://api.example.com
CORE_API_AUTH_FRONTEND_URI=https://app.example.com
# Generate independently: openssl rand -hex 32
CORE_API_AUTH_JWT_SECRET=
# Register the terminal origin under Google Authorized JavaScript origins.
# Supply the public Google client ID. No redirect URI or client secret is used.
CORE_API_AUTH_PROVIDERS='[{"name":"google","issuer":"https://accounts.google.com","client_id":""}]'

# Signup creates a pending user on the first successful Google authentication.
# Existing users can still log in if you later disable signup.
CORE_API_USER_SIGNUP_ENABLED=true
# Configure a case-sensitive, 1–128 byte code for the terminal's invite entry.
# Leaving this variable unset disables redemption; setting it empty fails startup.
# CORE_API_BETA_INVITE_CODE=<supply-through-your-secret-manager>
